# 让 git 统一处理换行：Windows 上克隆也不会把 CRLF 带进仓库
* text=auto

# 服务器上执行的脚本必须是 LF，否则 bash 会报 $'\r': command not found
*.sh       text eol=lf
*.py       text eol=lf
*.md       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.ini      text eol=lf
*.service  text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.txt      text eol=lf

# 二进制文件不要做换行/文本转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
